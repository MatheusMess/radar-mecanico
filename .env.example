# Copie para .env.local e preencha.
# Turso: https://turso.app  (crie um banco, pegue as credenciais em "Connect")
# O painel do Turso mostra "Database URL" e "Auth Token".

TURSO_DATABASE_URL=libsql://seu-banco-xxxx.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# Segredo usado para assinar o cookie de sessao.
# Gere um valor novo com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Para desenvolvimento local sem Turso, descomente e aponte para um arquivo:
# TURSO_DATABASE_URL=file:radar-mecanico.sqlite