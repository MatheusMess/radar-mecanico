# Copie para .env.local e preencha.
# Supabase: https://supabase.com  (crie um projeto, depois vá em
# Project Settings -> Database -> Connection string e copie a URI).
#
# Use a "Session pooler" (porta 5432) ou a "Transaction pooler" (porta 6543):
# a conexão direta do Supabase só responde por IPv6, que a Vercel não tem.
# A URI já inclui a senha do banco.

SUPABASE_DB_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# A integração Supabase da Vercel injeta POSTGRES_URL sozinha; o app também
# aceita esse nome, então nestes casos nem é preciso cadastrar a linha acima.

# Segredo usado para assinar o cookie de sessão.
# Gere um valor novo com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Para desenvolvimento local sem Supabase, basta não definir SUPABASE_DB_URL:
# o projeto usa um Postgres embutido (PGlite) na pasta .local-pg.
# PGLITE_DIR=.local-pg
